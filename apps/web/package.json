    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "^15",
    "openapi-fetch": "^0.17.0",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.187.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
