# ---------------------------------------------------------------
# OpsDesk Control Tower: environment variables
# Copy to .env and adjust. No real secrets belong in this file.
# ---------------------------------------------------------------

# --- API (apps/api) ---
# Environment name: development | test | production
APP_ENV=development
# Database. SQLite (WAL) by default; set a postgresql+asyncpg:// URL to use Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/opsdesk.db
# JWT signing secret. Leave empty: a random secret is generated on first run
# and stored in apps/api/.secrets/jwt_secret (gitignored).
JWT_SECRET=
# Session lifetime in minutes
JWT_EXPIRES_MINUTES=720
# Name of the httpOnly session cookie
SESSION_COOKIE_NAME=opsdesk_session
# Set true behind HTTPS so the cookie gets the Secure flag
COOKIE_SECURE=false
# Comma-separated list of allowed web origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Background jobs (SLA tick every minute). Disabled automatically in tests.
SCHEDULER_ENABLED=true
SLA_TICK_SECONDS=60
# Retention: closed tickets older than this move to archive_tickets
ARCHIVE_AFTER_DAYS=90
# Login rate limit (attempts per minute per IP)
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Demo-only password used by the seed script for every demo user
DEMO_PASSWORD=cleared-for-takeoff
# Optional: enables LLM-backed Co-pilot features later (never required)
ANTHROPIC_API_KEY=

# --- Web (apps/web) ---
# Where the Next.js server proxies /api/* requests
API_ORIGIN=http://localhost:8000
# Public base URL of the API used by the browser for SSE (falls back to /api)
NEXT_PUBLIC_API_BASE=/api
# Pretrained MiniLM sentence embeddings for linking and intent (downloads ~90 MB once; false = TF-IDF only)
EMBEDDINGS_ENABLED=true
